# Copia este archivo como .env y coloca tus valores reales.

# API key de Groq: https://console.groq.com/keys
API_KEY_GROQ=tu_api_key_de_groq

# (Opcional) Cadena de conexión de PostgreSQL / Supabase para la memoria de largo plazo.
# Si se deja vacía o falla la conexión, el agente funciona solo con memoria de sesión.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres
